{
  "name": "@toolbox/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/client.server.ts",
    "./browser": "./src/client.browser.ts",
    "./types": "./src/types.gen.ts"
  },
  "scripts": {
    "lint": "echo 'db — lint via root'",
    "typecheck": "tsc --noEmit",
    "db:gen": "supabase gen types typescript --local > src/types.gen.ts",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.4",
    "@toolbox/auth": "workspace:*",
    "@toolbox/config": "workspace:*"
  },
  "devDependencies": {
    "supabase": "^1.200.0",
    "typescript": "^5.6.2"
  }
}
